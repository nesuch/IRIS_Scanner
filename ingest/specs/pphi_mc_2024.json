{
  "doc_id": "PPHI_MC",
  "sheet_name": "Protection of Policyholders Interests MC 2024",
  "title_case_titles": true,
  "preprocess": ["explode_stage_matrix"],
  "default_section_prefix": "PPHI-S1",
  "chapter_match": "^@@CH (\\S+)",
  "chapter_id_label": "",
  "ignore_patterns": [
    "^\\s*\\d{0,3}\\s*[IjlJ1]?\\s*P\\s*a.{0,2}g.{0,2}e\\s*$",
    "^\\s*\\d{1,4}\\s*[|Ilj/1]+\\s*/?\\s*P\\s*a\\s*g\\s*e\\s*$",
    "^[~_]+$",
    "^Servicing of Policyholders$",
    "^Ombudsman Awards$"
  ],
  "containers": [
    {"head_match": "^(Section 2)\\b\\s*(.*)$", "id_prefix": "PPHI-S2", "clause_template": "{head}:", "include": true, "collect_body": true},
    {"head_match": "^(Chapter I)\\b", "id_prefix": "PPHI-S2-CH1", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(Chapter II)\\b", "id_prefix": "PPHI-S2-CH2", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER III)\\b", "id_prefix": "PPHI-S2-CH3", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER IV)\\b", "id_prefix": "PPHI-S2-CH4", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER V)\\b", "id_prefix": "PPHI-S2-CH5", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER VI)\\b", "id_prefix": "PPHI-S2-CH6", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER VII)\\b", "id_prefix": "PPHI-S2-CH7", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER VIII)\\b", "id_prefix": "PPHI-S2-CH8", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^(CHAPTER IX)\\b", "id_prefix": "PPHI-S2-CH9", "title_next_line": true, "clause_template": "{title}:", "include": true},
    {"head_match": "^SCHEDULE\\s*[-\\u2013]?\\s*A\\b\\s*[-\\u2013]?\\s*(.*)$", "id_prefix": "PPHI-SCHA", "clause_template": "Schedule A: {title}:", "include": true, "collect_body": true},
    {"head_match": "^Schedule\\s*[-\\u2013]?\\s*B\\s*()$", "id_prefix": "PPHI-SCHB", "clause_template": "Schedule B: {title}:", "include": true, "collect_body": true},
    {"head_match": "^SCHEDULE\\s*[-\\u2013]?\\s*C\\b\\s*(.*)$", "id_prefix": "PPHI-SCHC", "clause_template": "Schedule C: {title}:", "include": true, "collect_body": true},
    {"head_match": "^SCHEDULE\\s*[-\\u2013]?\\s*D\\b\\s*(.*)$", "id_prefix": "PPHI-SCHD", "clause_template": "Schedule D: {title}:", "include": true, "collect_body": true},
    {"head_match": "^Annexure\\s+(\\d+)\\b\\s*[:\\-\\u2013]?\\s*(.*)$", "id_prefix": "PPHI-ANX{n}", "clause_template": "Annexure {n}: {title}:", "include": true, "collect_body": true}
  ],
  "section": {"match": "^(\\d+)\\.(?=\\s|[A-Z])", "delimiter": ":"},
  "attach_orphans_to_last": true,
  "subblock_on_restart": true,
  "tag_rule": {"max_len": 300}
}
