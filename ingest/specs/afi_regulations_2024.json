{
  "doc_id": "AFI_REGS",
  "sheet_name": "IRDAI Actuarial Finance Investment Regulations 2024",
  "ignore_patterns": [
    "THE GAZETTE OF INDIA",
    "GI/\\d+",
    "^\\[ADVT",
    "PUBLISHED BY AUTHORITY",
    "^EXTRAORDINARY$",
    "^No\\.\\s*\\d+\\]",
    "INSURANCE REGULATORY AND DEVELOPMENT AUTHORITY OF INDIA",
    "^NOTIFICATION$",
    "^Hyderabad, the\\b",
    "^[A-Z][A-Z .]+,\\s*Chairperson"
  ],
  "scope_start": "^CHAPTER-I\\b",

  "chapter_match": "^SCHEDULE\\s*[-\\u2013\\u2014]?\\s*(I{1,3})\\b",

  "containers": [
    {"head_match": "^(CHAPTER[-\\s]*[IVX]+)\\b\\s*(.*)$", "title_next_line": true,
     "id_prefix": "AFI_REGS-CH{n}", "clause_template": "Chapter {n}: {title}:",
     "include": true},

    {"head_match": "^(SCHEDULE\\s*[-\\u2013\\u2014]?\\s*(?:IV|V))\\b\\s*[:\\u2013\\u2014-]?\\s*(.*)$",
     "id_prefix": "AFI_REGS-SCH-{n}", "clause_template": "Schedule {n}: {title}:",
     "include": true},

    {"head_match": "^((?:PART|Part)\\s*[-\\s]*[IVX]+)(?:\\s*[:\\u2013\\u2014-]\\s*(.*))?\\s*$",
     "title_next_line": true,
     "id_prefix": "AFI_REGS-SCH-{parent}-P{n}", "clause_template": "Part {n}: {title}:",
     "include": true}
  ],

  "section": {"match": "^(\\d+)\\.\\s", "delimiter": ":", "max_x0": 110},
  "attach_orphans_to_last": true,
  "subblock_on_restart": true,

  "form_starts": [
    "SCHEDULES?\\s+FORMING\\s+PART\\s+OF\\s+FINANCIAL\\s+STATEMENTS",
    "^SCHEDULE\\s+\\d",
    "^FORM[\\s-]",
    "^PART\\s*[-\\u2013]\\s*[A-Z]\\b"
  ],
  "section_resume": [
    "^(?:PART|Part)\\s*[-\\s]*[IVX]+\\b",
    "^SCHEDULE\\s*[-\\u2013\\u2014]?\\s*[IVX]+\\b",
    "^CHAPTER"
  ],

  "tag_rule": {"max_len": 300}
}
