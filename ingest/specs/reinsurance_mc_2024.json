    "(?i)^form\\s*[–-]",
    "^Annex\\b",
    "^Appendix\\b",
    "Particulars of Key Management",
    "^JOINT CERTIFICATE",
    "CERTIFICATE OF REGISTRATION",
    "^APPLICATION FOR ISSUE OF DUPLICATE",
    "Certification for Compliance",
    "Certificate for "
  ],
  "section_resume": [
    "^CHAPTER\\b",
    "^Chapter\\b",
    "^\\d+\\.\\s+As per Regulation",
    "^\\d+\\.\\s+(Corporate Governance|Appointment|Repatriation of Funds|Surrender|Amalgamation|Outsourcing|Opening of additional|Transition provisions|Filing of applications|Advance Reinsurance)"
  ],
  "section": {
    "match": "^(\\d+)\\.\\s",
