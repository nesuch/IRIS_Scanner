    "^Border Reinsurers \\(CBRs\\)\\s*$"
  ],
  "scope_start": "^1\\.\\s+As per Regulation 5\\(3\\)",
  "default_section_prefix": "REINSURANCE_MC",
  "containers": [
    {
      "head_match": "^(Collateral requirements for placement of reinsurance.*)$",
