{
  "doc_id": "REINSURANCE_MC",
  "sheet_name": "IRDAI Master Circular on Reinsurance 2024",
  "ignore_patterns": [
    "^Page\\s*\\d+\\s*of\\s*\\d+\\s*$",
    "irdai\\.gov\\.in",
    "^\\s*[•·]\\s*$",
    "^\\s*ialai\\s*$",
    "^और\\s*/\\s*And\\s*$",
    "Amrit Mahotsav",
    "INSURANCE REGULATORY AND",
