# Keep the build context small and the image clean.
.git/
.gitignore
.gitattributes
.vscode/
.claude/
README.md

# Python envs / caches
venv/
venv310/
**/__pycache__/
*.pyc

# Frontend: ship only the built dist (committed); skip source + node_modules
frontend/node_modules/
frontend/src/
frontend/public/
frontend/index.html
frontend/vite.config.js
frontend/package.json
frontend/package-lock.json
frontend/eslint.config.js

# Databases: ship ONLY iris.db (baked as the seed); never the ~1.4GB of
# iris_backup_*.db snapshots, the pre-migration db, or WAL/SHM sidecars.
*.db
!iris.db
*.db-wal
*.db-shm

# Obsolete handbook/POC seed files — superseded by the curated iris.db, kept
# locally for reference only (never ingested; see SYNC_SKIP_FILES).
seed_archive/

# Runtime / OS junk — never bake these into the image
**/.DS_Store
*.bak
*.orig
