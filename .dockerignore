# Keep the build context small and the image clean.
.git/
.gitignore
.gitattributes
.vscode/
.claude/
README.md

# Python envs / caches
venv/
venv310/
**/__pycache__/
*.pyc

# Frontend: ship only the built dist (committed); skip source + node_modules
frontend/node_modules/
frontend/src/
frontend/public/
frontend/index.html
frontend/vite.config.js
frontend/package.json
frontend/package-lock.json
frontend/eslint.config.js

# Runtime / OS junk — never bake these into the image
*.db-wal
*.db-shm
**/.DS_Store
*.bak
*.orig
